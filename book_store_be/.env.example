PORT=5000
MONGODB_URL=mongodb://localhost:27017/bookstore
REDIS_URL=redis://localhost:6379
JWT_ACCESS_KEY=change-me
JWT_REFRESH_KEY=change-me

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_KEY=
# Optional: comma-separated models tried in order. The free tier caps requests
# per model per day, so the fallbacks multiply the daily allowance.
# Default: gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MODEL=
# Optional: minimum ms between Gemini calls process-wide (default 1000)
GEMINI_MIN_GAP_MS=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

VNPAY_TMN_CODE=
VNPAY_SECURE_SECRET=
