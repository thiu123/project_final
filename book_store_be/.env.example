PORT=5000
NODE_ENV=development
MONGODB_URL=mongodb://localhost:27017/bookstore
REDIS_URL=redis://localhost:6379
# Two different random strings, at least 32 characters each. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Optional: comma-separated origins allowed by CORS (default: FRONTEND_URL)
CORS_ORIGINS=
# Optional: set when running behind a reverse proxy so rate limits see the
# real client IP, e.g. 1 for a single proxy hop
TRUST_PROXY=

# SMTP for password reset emails. Without it, emails are only logged in dev.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD=<app password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_KEY=
# Optional: comma-separated models tried in order. The free tier caps requests
# per model per day, so the fallbacks multiply the daily allowance.
# Default: gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MODEL=
# Optional: minimum ms between Gemini calls process-wide (default 1000)
GEMINI_MIN_GAP_MS=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

VNPAY_TMN_CODE=
VNPAY_SECURE_SECRET=
